# Copy to .env and fill in. .env is ignored by git; never commit it.

# Sheety: the endpoints of the "prices" sheet (destinations) and the "users" sheet
# (the club's customers, filled by a Google Form), and the Bearer token of the project
SHEETY_PRICES_ENDPOINT=https://api.sheety.co/<your-id>/<your-project>/prices
SHEETY_USERS_ENDPOINT=https://api.sheety.co/<your-id>/<your-project>/users
SHEETY_TOKEN=

# Flight provider: "serpapi" or "mock" (the course's mock flight service)
FLIGHT_PROVIDER=mock
SERPAPI_API_KEY=
MOCK_FLIGHTS_APP_ID=
MOCK_FLIGHTS_APP_KEY=
# Optional: override the default URL of the mock flight service
# MOCK_FLIGHTS_URL=

# WhatsApp: your own number with country code, for example +441234567890
# Needs the optional extra: python -m pip install -e ".[whatsapp]"
WHATSAPP_NUMBER=

# Email: the SMTP server, the sender and an app password (not your normal password).
# Every customer in the "users" sheet gets the deal by email.
SMTP_ADDRESS=smtp.gmail.com
EMAIL_ADDRESS=
EMAIL_PASSWORD=
