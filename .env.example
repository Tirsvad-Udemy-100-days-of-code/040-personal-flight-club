# Copy to .env and fill in. .env is ignored by git; never commit it.

# Sheety: the endpoint of the "prices" sheet and the Bearer token of the project
SHEETY_ENDPOINT=https://api.sheety.co/<your-id>/<your-project>/prices
SHEETY_TOKEN=

# Flight provider: "serpapi" or "mock" (the course's mock flight service)
FLIGHT_PROVIDER=mock
SERPAPI_API_KEY=
MOCK_FLIGHTS_APP_ID=
MOCK_FLIGHTS_APP_KEY=
# Optional: override the default URL of the mock flight service
# MOCK_FLIGHTS_URL=

# WhatsApp: your own number with country code, for example +441234567890
# Needs the optional extra: python -m pip install -e ".[whatsapp]"
WHATSAPP_NUMBER=
